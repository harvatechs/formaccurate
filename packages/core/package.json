{
  "name": "@formaccurate/core",
  "version": "0.1.0",
  "description": "Schema types, Zod validation engine, state machine, and JSON Schema export for FormAccurate.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
