{
  "name": "@formaccurate/server",
  "version": "0.1.0",
  "description": "Hono-based HTTP layer, discovery endpoint, and storage adapter for FormAccurate.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@formaccurate/core": "workspace:*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formaccurate/formaccurate.git",
    "directory": "packages/server"
  }
}
