{
  "name": "@formaccurate/web",
  "version": "0.1.0",
  "description": "Browser SDK and DOM bridge for FormAccurate.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@formaccurate/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.3.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harvatechs/formaccurate.git",
    "directory": "packages/web"
  }
}
