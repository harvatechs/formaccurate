{
  "name": "formaccurate-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Make web forms natively agent-readable without vision models or DOM guessing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harvatechs/formaccurate.git"
  },
  "bugs": {
    "url": "https://github.com/harvatechs/formaccurate/issues"
  },
  "homepage": "https://github.com/harvatechs/formaccurate#readme",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "changeset": "changeset",
    "publish:packages": "pnpm -r publish",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "happy-dom": ">=20.8.9"
    }
  }
}
